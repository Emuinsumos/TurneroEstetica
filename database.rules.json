{
  "rules": {
    "$app": {
      ".read": "$app !== 'turneroProfesionales' && $app !== 'turneroEstetica'",
      ".write": "$app !== 'turneroProfesionales' && $app !== 'turneroEstetica'",
      "businesses": {
        "$b": {
          "config": {
            ".read": true,
            ".write": "auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales'))"
          },
          "services": {
            ".read": true,
            ".write": "auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales'))"
          },
          "professionals": {
            ".read": true,
            ".write": "auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales'))"
          },
          "availability": {
            ".read": true,
            ".write": "auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales'))"
          },
          "blockedSlots": {
            ".read": true,
            ".write": "auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales'))"
          },
          "media": {
            "$id": {
              ".read": true,
              ".write": "auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales'))",
              ".validate": "newData.isString() && newData.val().matches(/^data:image\\/(webp|jpeg|png);base64,/) && newData.val().length <= 300000"
            }
          },
          "slotLocks": {
            "$prof": {
              "$date": {
                ".read": true,
                "$slot": {
                  ".write": "(auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales')) && !newData.exists()) || (!data.exists() && newData.exists())",
                  ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $slot.matches(/^[0-2][0-9][0-5][0-9]$/) && newData.isString() && newData.parent().parent().parent().parent().child('appointments').child(newData.val()).child('professionalId').val() === $prof && newData.parent().parent().parent().parent().child('appointments').child(newData.val()).child('date').val() === $date"
                }
              }
            }
          },
          "appointments": {
            ".read": "auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales'))",
            ".indexOn": [
              "date",
              "professionalId",
              "status"
            ],
            "$id": {
              ".write": "(auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales'))) || (!data.exists() && newData.exists())",
              ".validate": "newData.hasChildren(['clientName','clientPhone','serviceId','professionalId','date','time','status','priceAtBooking','createdAt']) && newData.child('clientName').isString() && newData.child('clientName').val().length >= 2 && newData.child('clientName').val().length <= 80 && newData.child('clientPhone').isString() && newData.child('clientPhone').val().matches(/^[0-9+ ()-]{6,20}$/) && newData.child('date').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('time').val().matches(/^[0-2][0-9]:[0-5][0-9]$/) && newData.child('priceAtBooking').isNumber() && (newData.child('status').val() === 'pendiente' || (auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales')))) && (!newData.child('notes').exists() || newData.child('notes').val().length <= 300)",
              "$field": {
                ".validate": "$field.matches(/^(clientName|clientPhone|serviceId|serviceName|professionalId|professionalName|date|time|endTime|duration|status|priceAtBooking|notes|createdAt|updatedAt|history|slots)$/)"
              }
            }
          },
          "auditLog": {
            ".read": "auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales'))",
            ".write": "auth.token.role === 'admin' && auth.token.businessId === $b && (auth.token.root === $app || (auth.token.root == null && $app === 'turneroProfesionales'))"
          }
        }
      }
    }
  }
}
